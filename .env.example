# GNM Attendance System - Environment Variables
# ==============================================

# ==============================================
# Backend Configuration
# ==============================================
NODE_ENV=production
PORT=10000

# MongoDB Connection String (Use MongoDB Atlas)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/gnm-attendance?retryWrites=true&w=majority

# JWT Secret Key (Use a strong, unique secret in production)
JWT_SECRET=your-very-strong-secret-key-here-change-this-in-production

# URLs for CORS and Frontend Integration
FRONTEND_URL=https://gnm-attendance-dashboard.netlify.app
BACKEND_URL=https://gnm-group-attendance.onrender.com

# ==============================================
# Frontend Configuration (Development Only)
# ==============================================
VITE_API_URL=http://localhost:5000